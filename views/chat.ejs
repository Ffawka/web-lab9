<!DOCTYPE html>
<html>
<head>
    <title>Словарная игра</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            background: #1a1a2e;
            padding: 20px;
        }
        
        #auth {
            max-width: 400px;
            margin: 100px auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
        }
        
        #auth input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }
        
        #auth button {
            padding: 10px 30px;
            background: #e94560;
            color: white;
            border: none;
            cursor: pointer;
        }
        
        #game {
            display: none;
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }
        
        .game-header {
            background: #16213e;
            color: white;
            padding: 15px;
            text-align: center;
        }
        
        .game-info {
            background: #0f3460;
            color: white;
            padding: 10px;
            text-align: center;
            font-size: 18px;
        }
        
        .messages {
            height: 400px;
            overflow-y: auto;
            padding: 15px;
            background: #f5f5f5;
        }
        
        .message {
            padding: 8px;
            margin: 5px 0;
            border-radius: 5px;
        }
        
        .system {
            background: #e0e0e0;
            color: #555;
            text-align: center;
            font-size: 12px;
        }
        
        .chat {
            background: white;
            border-left: 3px solid #e94560;
        }
        
        .game {
            background: #d4edda;
            border-left: 3px solid #28a745;
        }
        
        .form {
            display: flex;
            padding: 15px;
            gap: 10px;
        }
        
        .form input {
            flex: 1;
            padding: 10px;
            font-size: 16px;
        }
        
        .form button {
            padding: 10px 20px;
            background: #e94560;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>

<div id="auth">
    <h2>Словарная игра</h2>
    <input type="text" id="username" placeholder="Введите имя...">
    <button onclick="join()">Войти в игру</button>
</div>

<div id="game">
    <div class="game-header">
        <h2>Игра «Слова»</h2>
    </div>
    <div class="game-info" id="gameInfo">
        Ожидание игроков...
    </div>
    <div class="messages" id="messages"></div>
    <div class="form">
        <input type="text" id="input" placeholder="Введите слово...">
        <button onclick="sendMessage()">Отправить</button>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    
    function join() {
        let name = document.getElementById('username').value.trim();
        if (name) {
            socket.emit('set username', name);
            document.getElementById('auth').style.display = 'none';
            document.getElementById('game').style.display = 'block';
        }
    }
    
    function sendMessage() {
        let input = document.getElementById('input');
        let msg = input.value.trim();
        if (msg) {
            socket.emit('chat message', msg);
            input.value = '';
        }
    }
    
    document.getElementById('input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });
    
    function addMessage(type, from, text) {
        let messages = document.getElementById('messages');
        let div = document.createElement('div');
        div.className = 'message ' + type;
        
        if (type === 'system') {
            div.textContent = text;
        } else if (type === 'chat') {
            div.textContent = `${from}: ${text}`;
        } else if (type === 'game') {
            div.textContent = `${text}`;
        }
        
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
    }

    socket.on('system_msg', (msg) => {
        addMessage('system', null, msg);
    });
    
    socket.on('chat_msg', (data) => {
        addMessage('chat', data.username, data.text);
    });
    
    socket.on('game_start', (data) => {
        document.getElementById('gameInfo').innerHTML = `Игра идёт! Текущее слово: "${data.currentWord}"<br>Ходит: ${data.currentPlayer}`;
        addMessage('game', null, `Игра началась! Первое слово: "${data.currentWord}". Ходит ${data.currentPlayer}`);
    });
    
    socket.on('turn_change', (data) => {
        document.getElementById('gameInfo').innerHTML = `Игра идёт! Текущее слово: "${data.currentWord}"<br>Ходит: ${data.currentPlayer}`;
        addMessage('game', null, `Ходит ${data.currentPlayer}. Слово: "${data.currentWord}"`);
    });
    
    socket.on('game_end', (data) => {
        if (data.winner) {
            document.getElementById('gameInfo').innerHTML = `Игра закончена! Победил ${data.winner}!`;
            addMessage('game', null, `ПОБЕДА! Выиграл ${data.winner}!`);
        } else {
            document.getElementById('gameInfo').innerHTML = `Игра остановлена`;
        }
    });
</script>

</body>
</html>
